{
  "name": "nextup-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npx -y tsx@^4.23.15 --test test/*.test.ts",
    "pack": "npm run build && npx -y -p @evenrealities/evenhub-cli@^0.2.0 evenhub pack app.json dist",
    "simulate": "npx -y -p @evenrealities/evenhub-simulator@^0.9.5 evenhub-simulator http://localhost:5173",
    "qr": "npx -y -p @evenrealities/evenhub-cli@^0.2.0 evenhub qr --url http://$(node -e \"const o=require('os').networkInterfaces();console.log(Object.values(o).flat().find(i=>i.family==='IPv4'&&!i.internal).address)\"):5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
