# Copy to .env (or set these in Railway). Every integration is optional:
# with none set, the server runs on demo data so the app works end to end.

PORT=8787
# Public URL of this server. Used for the pairing link and Google sign-in redirect.
PUBLIC_URL=http://localhost:8787
# Long random string. Signs the phone's session cookie.
SESSION_SECRET=
# Where user accounts are stored. On Railway, mount a volume at /data.
DATA_FILE=./data/store.json
# Seconds an approved action waits before running, so it can be undone.
UNDO_SECONDS=10

# Google Calendar + Gmail (Google Cloud console → OAuth client, type "Web application").
# Authorised redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram user login (my.telegram.org → API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# LLM through OpenRouter for briefs and drafts. Without it, rules-based drafts are used.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint.
# Groq (fast, free tier): https://api.groq.com/openai/v1 with whisper-large-v3-turbo
# OpenAI: https://api.openai.com/v1 with whisper-1
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
